@article{kauffmann_lisa_llm_2025,
title = {Leveraging LLMs for interpreting historical source code: a case study of the Apple Lisa through critical code studies},
author = {Kauffmann, Titaÿna},
journal = {AI \& Society},
year = {2025},
month = dec,
